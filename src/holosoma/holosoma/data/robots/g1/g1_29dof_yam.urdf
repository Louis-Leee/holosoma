    <!-- ===== Bota force/torque sensor (left hand), mirror of the right: wrist ->
         FT sensor -> yam gripper. Mesh metre-scale; link frame axis-aligned with
         left_wrist_yaw_link (rpy=0), FT puck a fixed child at wrist +x 0.072 m.
         Visual yaw +90deg = the 180deg-flipped orientation matching the right hand
         (sensor mounted backwards on the real rig). Cosmetic only; not in IK/data. ===== -->
    <joint name="left_ft_sensor_joint" type="fixed">
        <origin xyz="0.072 0 0" rpy="0 0 0"/>
        <parent link="left_wrist_yaw_link"/>
        <child link="left_ft_sensor_link"/>
    </joint>
    <link name="left_ft_sensor_link">
        <inertial>
            <origin xyz="0.015 0 0" rpy="0 0 0"/>
            <mass value="0.1"/>
            <inertia ixx="3e-5" ixy="0" ixz="0" iyy="3e-5" iyz="0" izz="3e-5"/>
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 1.570796327"/>
            <geometry>
                <mesh filename="meshes/FT_sensor.STL"/>
            </geometry>
            <material name="ft_sensor_body">
                <color rgba="0.15 0.15 0.18 1"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 1.570796327"/>
            <geometry>
                <mesh filename="meshes/FT_sensor.STL"/>
            </geometry>
        </collision>
    </link>
    <!-- Gripper re-parented onto the FT sensor link. FT link at wrist +x 0.072;
         origin x 0.0095 puts the gripper base at wrist +x 0.0815 (matches the right
         hand; see the right-hand block for the full mount history). -->
    <joint name="left_hand_palm_joint" type="fixed">
        <origin xyz="0.0095 0.003 0" rpy="0 0 0"/>
        <parent link="left_ft_sensor_link"/>
        <child link="left_rubber_hand"/>
    </joint>
    <!-- ===== i2rt linear_4310 gripper (replaces the fused pika rubber_hand) =====
         Faithful port of thirdparty/i2rt/.../gripper/linear_4310/linear_4310.xml.
         The left_rubber_hand base link keeps its name + frame (palm joint stays rpy=0, so
         R(left_rubber_hand)==R(left_wrist_yaw_link)). The linear_4310 native -z approach is
         rotated to the pika-style +x approach by R_mount=Ry(-90deg), folded into the
         origins below. Two prismatic jaws slide along local -z, range [0, 0.0475].
         The jaws are HOOKED claws, so the FINGERTIPS (the grasp contact) move
         opposite to the link COMs: q=0 -> fingertips touch (CLOSED), q=0.0475 ->
         fingertips ~98 mm apart (OPEN). finger2 mimics finger1 1:1 (== i2rt
         <equality joint7=joint8>). The wrist→hand chain is wrist_yaw
         -(ft_sensor_joint 0.072)-> ft_sensor -(hand_palm_joint 0.0095)-> rubber_hand,
         so the gripper base sits at wrist +x 0.0815 (= 0.072 + 0.0095);
         grasp/TCP fingertips reach ~0.215 m forward of left_wrist_yaw_link along +x.
         NOTE: MuJoCo's URDF loader DROPS <mimic> and does NOT auto-exclude the two
         sibling jaws -> a MuJoCo load needs a post-load MjSpec patch (joint-couple
         equality + jaw<->jaw <exclude>). IsaacLab/PhysX honor <mimic> directly. -->
    <link name="left_rubber_hand">
        <inertial>
            <origin xyz="0.0293133 0.000249371 -3.57066e-05" rpy="0 0 0"/>
            <mass value="0.553219"/>
            <inertia ixx="0.0003692488261" ixy="4.83956503e-06" ixz="-7.912716748e-07" iyy="0.000324942066" iyz="5.449424663e-07" izz="0.0004096681079"/>
        </inertial>
        <visual>
            <origin xyz="-0.0731 -0.0463995 -0.014" rpy="0 -1.570796327 0"/>
            <geometry>
                <mesh filename="meshes/yam_gripper_base.STL"/>
            </geometry>
            <material name="yam_gripper_body">
                <color rgba="0.11 0.286 0.012 1"/>
            </material>
        </visual>
        <collision>
            <origin xyz="-0.0731 -0.0463995 -0.014" rpy="0 -1.570796327 0"/>
            <geometry>
                <mesh filename="meshes/yam_gripper_base.STL"/>
            </geometry>
        </collision>
    </link>
    <joint name="left_gripper_finger1_joint" type="prismatic">
        <origin xyz="0.0545599 0.0450619 -0.0238981" rpy="1.570792327 4e-06 3.141592654"/>
        <parent link="left_rubber_hand"/>
        <child link="left_gripper_finger1_link"/>
        <axis xyz="0 0 -1"/>
        <limit lower="0" upper="0.0475" effort="100" velocity="5"/>
    </joint>
    <link name="left_gripper_finger1_link">
