    </link>
    <joint name="right_wrist_yaw_joint" type="revolute">
        <origin xyz="0.046 0 0" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
        <parent link="right_wrist_pitch_link"/>
        <child link="right_wrist_yaw_link"/>
        <limit effort="5" velocity="22" lower="-1.614429558" upper="1.614429558"/>
    </joint>
    <link name="right_wrist_yaw_link">
        <inertial>
            <origin xyz="0.02200381568 -0.00049485096 0.00053861123" rpy="0 0 0"/>
            <mass value="0.08457647"/>
            <inertia ixx="0.00004929128828" ixy="0.00000045735494" ixz="0.00000445867591" iyy="0.00005973338134"
                     iyz="-0.00000043217198" izz="0.00003928083826"/>
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="meshes/right_wrist_yaw_link.STL"/>
            </geometry>
            <material name="white">
                <color rgba="0.7 0.7 0.7 1"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0.075 0 0" rpy="0 -1.5708 0"/>
            <geometry>
                <cylinder radius="0.05" length="0.05"/>
            </geometry>
        </collision>
    </link>
    <!-- ===== Bota force/torque sensor, mounted inline between the wrist and the
         yam gripper (real rig: G1 wrist -> FT sensor -> yam gripper). The mesh
         (meshes/FT_sensor.STL) is METRE-scale already (~51x51 mm disc, 31 mm tall).
         The link frame is AXIS-ALIGNED with right_wrist_yaw_link (rpy=0); the puck
         is a fixed child at wrist +x 0.072 m. Only the <visual>/<collision> mesh
         origin carries the orientation. FLIPPED 180deg about z (yaw -90 -> +90)
         because the sensor was mounted backwards on the real rig; if the intended
         flip axis differs, change the yaw sign / use roll=pi. Keeping the link
         frame unrotated lets the gripper re-parent below carry a clean +x offset.
         The visual is cosmetic for the viz and does NOT enter recorded data or IK. ===== -->
    <joint name="right_ft_sensor_joint" type="fixed">
        <origin xyz="0.072 0 0" rpy="0 0 0"/>
        <parent link="right_wrist_yaw_link"/>
        <child link="right_ft_sensor_link"/>
    </joint>
    <link name="right_ft_sensor_link">
        <inertial>
            <origin xyz="0.015 0 0" rpy="0 0 0"/>
            <mass value="0.1"/>
            <inertia ixx="3e-5" ixy="0" ixz="0" iyy="3e-5" iyz="0" izz="3e-5"/>
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 1.570796327"/>
            <geometry>
                <mesh filename="meshes/FT_sensor.STL"/>
            </geometry>
            <material name="ft_sensor_body">
                <color rgba="0.15 0.15 0.18 1"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 1.570796327"/>
            <geometry>
                <mesh filename="meshes/FT_sensor.STL"/>
            </geometry>
        </collision>
    </link>
    <!-- Gripper re-parented onto the FT sensor link (wrist -> FT -> gripper). The
         FT link frame is at wrist +x 0.072; origin x 0.0095 puts the gripper base
         at wrist +x 0.0815. Mount history (all along wrist +x): FT 0.042->0.092->
         0.072 (net +3 cm out), gripper base 0.0715->0.1415->0.1115->0.0815.
         Grasp/TCP tracks the gripper -> tcp_extrinsic 0.20->0.27->0.24->0.21 m
         to stay consistent (see robot_assets/calibration/). -->
    <joint name="right_hand_palm_joint" type="fixed">
        <origin xyz="0.0095 -0.003 0" rpy="0 0 0"/>
        <parent link="right_ft_sensor_link"/>
        <child link="right_rubber_hand"/>
    </joint>
    <!-- ===== i2rt linear_4310 gripper (replaces the fused pika rubber_hand) =====
         Faithful port of thirdparty/i2rt/.../gripper/linear_4310/linear_4310.xml.
         The right_rubber_hand base link keeps its name + frame (palm joint stays rpy=0, so
         R(right_rubber_hand)==R(right_wrist_yaw_link)). The linear_4310 native -z approach is
         rotated to the pika-style +x approach by R_mount=Ry(-90deg), folded into the
         origins below. Two prismatic jaws slide along local -z, range [0, 0.0475].
         The jaws are HOOKED claws, so the FINGERTIPS (the grasp contact) move
         opposite to the link COMs: q=0 -> fingertips touch (CLOSED), q=0.0475 ->
         fingertips ~98 mm apart (OPEN). finger2 mimics finger1 1:1 (== i2rt
         <equality joint7=joint8>). The wrist→hand chain is wrist_yaw
         -(ft_sensor_joint 0.072)-> ft_sensor -(hand_palm_joint 0.0095)-> rubber_hand,
         so the gripper base sits at wrist +x 0.0815 (= 0.072 + 0.0095);
         grasp/TCP fingertips reach ~0.215 m forward of right_wrist_yaw_link along +x.
         NOTE: MuJoCo's URDF loader DROPS <mimic> and does NOT auto-exclude the two
         sibling jaws -> a MuJoCo load needs a post-load MjSpec patch (joint-couple
         equality + jaw<->jaw <exclude>). IsaacLab/PhysX honor <mimic> directly. -->
    <link name="right_rubber_hand">
        <inertial>
            <origin xyz="0.0293133 0.000249371 -3.57066e-05" rpy="0 0 0"/>
            <mass value="0.553219"/>
            <inertia ixx="0.0003692488261" ixy="4.83956503e-06" ixz="-7.912716748e-07" iyy="0.000324942066" iyz="5.449424663e-07" izz="0.0004096681079"/>
        </inertial>
        <visual>
            <origin xyz="-0.0731 -0.0463995 -0.014" rpy="0 -1.570796327 0"/>
            <geometry>
                <mesh filename="meshes/yam_gripper_base.STL"/>
            </geometry>
            <material name="yam_gripper_body">
                <color rgba="0.11 0.286 0.012 1"/>
            </material>
        </visual>
        <collision>
            <origin xyz="-0.0731 -0.0463995 -0.014" rpy="0 -1.570796327 0"/>
            <geometry>
                <mesh filename="meshes/yam_gripper_base.STL"/>
            </geometry>
        </collision>
    </link>
    <joint name="right_gripper_finger1_joint" type="prismatic">
        <origin xyz="0.0545599 0.0450619 -0.0238981" rpy="1.570792327 4e-06 3.141592654"/>
        <parent link="right_rubber_hand"/>
        <child link="right_gripper_finger1_link"/>
        <axis xyz="0 0 -1"/>
        <limit lower="0" upper="0.0475" effort="100" velocity="5"/>
    </joint>
    <link name="right_gripper_finger1_link">
        <inertial>
            <origin xyz="-0.0224716 0.0143408 -0.0426253" rpy="0 0 0"/>
            <mass value="0.0710042"/>
            <inertia ixx="4.823512339e-05" ixy="1.033660019e-05" ixz="-1.139040165e-05" iyy="5.195303692e-05" iyz="1.104870036e-05" izz="5.06981397e-05"/>
        </inertial>
        <visual>
            <origin xyz="0.129783 0.00999321 -0.0914614" rpy="1.570800327 -8.000045071e-12 1.570800327"/>
            <geometry>
                <mesh filename="meshes/yam_gripper_tip_left.STL"/>
            </geometry>
            <material name="yam_gripper_tip">
                <color rgba="0.596 0.788 0.922 1"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0.129783 0.00999321 -0.0914614" rpy="1.570800327 -8.000045071e-12 1.570800327"/>
            <geometry>
                <mesh filename="meshes/yam_gripper_tip_left.STL"/>
            </geometry>
        </collision>
    </link>
    <joint name="right_gripper_finger2_joint" type="prismatic">
        <origin xyz="0.0545599 -0.0450619 0.0238981" rpy="1.570800569 -1.570796327 0"/>
        <parent link="right_rubber_hand"/>
        <child link="right_gripper_finger2_link"/>
        <axis xyz="0 0 -1"/>
        <limit lower="0" upper="0.0475" effort="100" velocity="5"/>
        <mimic joint="right_gripper_finger1_joint" multiplier="1" offset="0"/>
    </joint>
    <link name="right_gripper_finger2_link">
        <inertial>
            <origin xyz="-0.0143408 -0.0224716 -0.0426253" rpy="0 0 0"/>
            <mass value="0.0710042"/>
            <inertia ixx="5.195304287e-05" ixy="-1.033660334e-05" ixz="-1.104869265e-05" iyy="4.823510792e-05" iyz="-1.139040427e-05" izz="5.069814922e-05"/>
        </inertial>
        <visual>
            <origin xyz="-0.0379932 0.129783 0.00133753" rpy="-1.570800569 0 0"/>
            <geometry>
                <mesh filename="meshes/yam_gripper_tip_right.STL"/>
            </geometry>
            <material name="yam_gripper_tip"/>
        </visual>
        <collision>
            <origin xyz="-0.0379932 0.129783 0.00133753" rpy="-1.570800569 0 0"/>
            <geometry>
                <mesh filename="meshes/yam_gripper_tip_right.STL"/>
            </geometry>
        </collision>
    </link>

    <link name="LL_FOOT">
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="1e-9"/>
            <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
        </inertial>
        <!-- Invisible visual required for USD conversion: IsaacLab expects visual prims for all links to avoid "Unresolved reference prim path" errors -->
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="0.001 0.001 0.001"/>
            </geometry>
            <material name="invisible">
                <color rgba="0 0 0 0"/>
            </material>
        </visual>
    </link>
    <joint name="LL_FOOT_frame" type="fixed">
        <origin xyz="0.04 0 -0.037" rpy="0 0 0"/>
        <parent link="left_ankle_roll_link"/>
        <child link="LL_FOOT"/>
    </joint>

    <link name="LR_FOOT">
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="1e-9"/>
            <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
        </inertial>
        <!-- Invisible visual required for USD conversion: IsaacLab expects visual prims for all links to avoid "Unresolved reference prim path" errors -->
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="0.001 0.001 0.001"/>
            </geometry>
            <material name="invisible">
                <color rgba="0 0 0 0"/>
            </material>
        </visual>
    </link>
    <joint name="LR_FOOT_frame" type="fixed">
        <origin xyz="0.04 0 -0.037" rpy="0 0 0"/>
        <parent link="right_ankle_roll_link"/>
        <child link="LR_FOOT"/>
    </joint>
</robot>
